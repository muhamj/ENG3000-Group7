#include <Arduino.h>
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>

const int SENSOR_1_TRIG_PIN = 32;
const int SENSOR_1_ECHO_PIN = 35;
const int SENSOR_2_TRIG_PIN = 12;
const int SENSOR_2_ECHO_PIN = 14;
const int LED_PIN = 2;

const uint8_t ESPNOW_CHANNEL = 1;

// Master/receiver ESP32 MAC address
uint8_t MASTER_MAC[] = {
  0x00, 0x70, 0x07, 0x7C, 0x72, 0xA4
};

struct SensorPacket {
  uint32_t packetNumber;
  float sensor3Cm;
  float sensor4Cm;
};

SensorPacket outgoingPacket;
uint32_t packetCounter = 0;


float readSensorDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 30000);

  if (duration <= 0) {
    return -1.0f;
  }

  return duration * 0.0343f / 2.0f;
}


void printDistanceValue(float distance) {
  if (distance < 0) {
    Serial.print("NaN");
  } else {
    Serial.print(distance, 2);
    Serial.print(" cm");
  }
}


void setup() {
  Serial.begin(115200);

  pinMode(LED_PIN, OUTPUT);

  pinMode(SENSOR_1_TRIG_PIN, OUTPUT);
  pinMode(SENSOR_1_ECHO_PIN, INPUT);
  pinMode(SENSOR_2_TRIG_PIN, OUTPUT);
  pinMode(SENSOR_2_ECHO_PIN, INPUT);

  digitalWrite(SENSOR_1_TRIG_PIN, LOW);
  digitalWrite(SENSOR_2_TRIG_PIN, LOW);

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  delay(100);

  esp_wifi_set_channel(
    ESPNOW_CHANNEL,
    WIFI_SECOND_CHAN_NONE
  );

  Serial.println("Slave ESP32 starting");

  Serial.print("Slave MAC address: ");
  Serial.println(WiFi.macAddress());

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW initialisation failed");

    while (true) {
      delay(1000);
    }
  }

  esp_now_peer_info_t masterInfo = {};

  memcpy(
    masterInfo.peer_addr,
    MASTER_MAC,
    6
  );

  masterInfo.channel = ESPNOW_CHANNEL;
  masterInfo.encrypt = false;
  masterInfo.ifidx = WIFI_IF_STA;

  if (esp_now_add_peer(&masterInfo) != ESP_OK) {
    Serial.println("Failed to add master ESP32");

    while (true) {
      delay(1000);
    }
  }

  Serial.println("Slave ready");
}


void loop() {
  digitalWrite(LED_PIN, HIGH);

  outgoingPacket.sensor3Cm = readSensorDistance(
    SENSOR_1_TRIG_PIN,
    SENSOR_1_ECHO_PIN
  );

  delay(60);

  outgoingPacket.sensor4Cm = readSensorDistance(
    SENSOR_2_TRIG_PIN,
    SENSOR_2_ECHO_PIN
  );

  outgoingPacket.packetNumber = ++packetCounter;

  esp_err_t result = esp_now_send(
    MASTER_MAC,
    reinterpret_cast<const uint8_t *>(&outgoingPacket),
    sizeof(outgoingPacket)
  );

  Serial.print("Packet ");
  Serial.print(outgoingPacket.packetNumber);

  Serial.print(" | sensor 3: ");
  printDistanceValue(outgoingPacket.sensor3Cm);

  Serial.print(" | sensor 4: ");
  printDistanceValue(outgoingPacket.sensor4Cm);

  Serial.print(" | send: ");
  Serial.println(result == ESP_OK ? "OK" : "FAILED");

  digitalWrite(LED_PIN, LOW);

  delay(1000);
}
