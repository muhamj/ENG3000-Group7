#include <WiFi.h>
#include <esp_now.h>

// Enter the receiver ESP32 MAC address here later.
uint8_t receiverAddress[] = {
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};

struct MessageData {
  char message[50];
  int number;
};

MessageData outgoingMessage;

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  delay(1000);

  Serial.println("Starting ESP-NOW sender");

  Serial.print("Sender MAC address: ");
  Serial.println(WiFi.macAddress());

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW initialisation failed");
    return;
  }

  esp_now_peer_info_t peerInfo = {};

  memcpy(
    peerInfo.peer_addr,
    receiverAddress,
    6
  );

  peerInfo.channel = 0;
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("Failed to add receiver");
    return;
  }

  Serial.println("Sender ready");
}

void loop() {
  static int messageNumber = 1;

  strcpy(
    outgoingMessage.message,
    "Hello from ESP32 sender!"
  );

  outgoingMessage.number = messageNumber;

  esp_err_t result = esp_now_send(
    receiverAddress,
    reinterpret_cast<uint8_t *>(&outgoingMessage),
    sizeof(outgoingMessage)
  );

  if (result == ESP_OK) {
    Serial.print("Message sent: ");
    Serial.println(messageNumber);
  } else {
    Serial.println("Error sending message");
  }

  messageNumber++;

  delay(1000);
}
